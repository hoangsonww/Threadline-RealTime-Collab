{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run lint:fix)",
      "Bash(npm run lint:shell)",
      "Bash(npm run typecheck)",
      "Bash(npm run format:check)",
      "Bash(npm run format)",
      "Bash(npm test)",
      "Bash(npm run test:watch)",
      "Bash(npm run test:coverage)",
      "Bash(npm run build)",
      "Bash(npm run check)",
      "Bash(npm run docs)",
      "Bash(npm run docs:check)",
      "Bash(npm run docs:links)",
      "Bash(npm run doctor)",
      "Bash(npm run openapi)",
      "Bash(npm run clean)",
      "Bash(npm ci)",
      "Bash(npm ls:*)",
      "Bash(npm run test --workspace=@threadline/realtime)",
      "Bash(make help)",
      "Bash(make check)",
      "Bash(make fast-check)",
      "Bash(make info)",
      "Bash(make ports)",
      "Bash(make doctor)",
      "Bash(make lint-shell)",
      "Bash(make docs-links)",
      "Bash(node scripts/verify-commit-message.mjs:*)",
      "Bash(node scripts/guard-staged.mjs)",
      "Bash(node scripts/check-doc-links.mjs)",
      "Bash(node scripts/lint-shell.mjs:*)",
      "Bash(node scripts/clean.mjs --dry-run)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git ls-files:*)",
      "Bash(git rev-parse:*)",
      "Bash(git blame:*)",
      "Bash(kubectl kustomize:*)",
      "Bash(docker compose config:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh release:*)",
      "Bash(npm publish:*)",
      "Bash(npm install:*)",
      "Bash(npm uninstall:*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose build:*)",
      "Bash(npm run docker:up)",
      "Bash(npm run clean:all)",
      "Bash(npx wrangler deploy:*)",
      "Bash(npm run deploy:*)"
    ],
    "deny": [
      "Read(./apps/web/.env.local)",
      "Read(./apps/web/.env)",
      "Read(./apps/realtime/.dev.vars)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./infra/kubernetes/overlays/**/secrets*.yaml)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/id_rsa*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fdx:*)",
      "Bash(rm -rf /:*)",
      "Bash(npx wrangler secret:*)"
    ]
  }
}
