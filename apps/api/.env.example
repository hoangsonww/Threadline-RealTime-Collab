PORT=4000
WEB_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/threadline
OIDC_ISSUER=http://localhost:4000
# Generate once and keep stable with: npm run generate:oidc-key --workspace=@threadline/api
# OIDC_PRIVATE_JWK={"kty":"RSA","n":"...","e":"AQAB","d":"...","kid":"threadline-key-1"}
ROOM_TICKET_SECRET=replace-with-a-separate-32-byte-secret
INTERNAL_INGEST_SECRET=replace-with-a-separate-32-byte-secret
# Optional but strongly recommended for production WebRTC reliability. Create a
# Cloudflare Realtime TURN key; its long-lived API token stays server-side here.
# TURN_KEY_ID=your-turn-key-id
# TURN_KEY_API_TOKEN=your-turn-key-api-token
COOKIE_SECURE=false
# AUTH_ACTION_ORIGIN=http://localhost:3000
# AUTH_DELIVERY_WEBHOOK=https://your-transactional-email-worker.example/send
# AUTH_DELIVERY_SECRET=replace-with-a-separate-secret
# Optional — error/performance monitoring. Unset means Sentry is inactive.
# SENTRY_DSN=https://<key>@o<org-id>.ingest.us.sentry.io/<project-id>
