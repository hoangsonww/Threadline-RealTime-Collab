{
  "$schema": "https://typedoc.org/schema.json",
  "name": "@threadline/api",
  "tsconfig": "./tsconfig.json",

  // The documented surface is what another module could legitimately import:
  // the domain vocabulary, the persistence port, the authorization decision
  // function, the security primitives, and the app factory. `index.ts` is a
  // process entry point rather than an API, and `instrument.ts` runs for its
  // side effects before anything else is loaded.
  "entryPoints": [
    "src/domain.ts",
    "src/policy.ts",
    "src/security.ts",
    "src/repository.ts",
    "src/application.ts",
    "src/turn.ts",
    "src/openapi.ts",
    "src/api-docs.ts"
  ],
  "entryPointStrategy": "expand",

  "exclude": ["**/*.test.ts", "**/node_modules/**", "scripts/**"],
  "excludeInternal": true,
  "excludePrivate": true
}
