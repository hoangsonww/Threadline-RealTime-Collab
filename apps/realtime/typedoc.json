{
  "$schema": "https://typedoc.org/schema.json",
  "name": "@threadline/realtime",
  "tsconfig": "./tsconfig.json",

  // A Worker's module surface is its default export and its Durable Object
  // class — everything a deployment binds to lives in this one file.
  "entryPoints": ["src/index.ts"],
  "entryPointStrategy": "expand",

  "exclude": ["**/*.test.ts", "**/node_modules/**", "worker-configuration.d.ts"],

  // `worker-configuration.d.ts` is generated by `wrangler types` and describes
  // the workerd runtime, not this service. Treating it as external keeps
  // `DurableObject` and friends out of the reference and out of the
  // not-exported validation, which would otherwise fail the build over types
  // this repository does not own.
  "externalPattern": ["**/node_modules/**", "**/worker-configuration.d.ts"],

  // These three are workerd's own ambient types. They appear in this service's
  // public signatures and cannot be re-exported from it, so they are declared
  // intentionally absent rather than silencing the not-exported check wholesale
  // — a genuinely missing export in `src/` still fails the build.
  "intentionallyNotExported": ["DurableObject", "DurableObjectNamespace", "DurableObjectState"],

  "excludeInternal": true,
  "excludePrivate": true
}
