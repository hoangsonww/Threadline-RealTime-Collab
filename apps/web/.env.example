# Fully local development (API and realtime both running locally):
# NEXT_PUBLIC_API_ORIGIN=http://localhost:4000
# NEXT_PUBLIC_REALTIME_ORIGIN=http://127.0.0.1:8787

# Hybrid development (local Next.js UI backed by deployed services):
# Keep browser API traffic same-origin so secure HttpOnly session cookies work
# reliably. Next.js proxies /api/identity/* to THREADLINE_API_ORIGIN.
THREADLINE_API_ORIGIN=https://your-threadline-api.vercel.app
NEXT_PUBLIC_API_ORIGIN=/api/identity
NEXT_PUBLIC_REALTIME_ORIGIN=https://your-threadline-realtime.workers.dev

# Optional — the canonical public origin. Drives the canonical link tag, the
# sitemap URLs, robots.txt's sitemap pointer, every JSON-LD @id, and the links
# in /llms.txt. Defaults to the production host when unset.
#
# Set it on a preview deployment so the preview advertises itself. A preview
# whose canonical tag points at production is worse than one with no canonical
# tag at all, because search engines act on it.
# NEXT_PUBLIC_SITE_URL=https://your-preview-deployment.vercel.app

# Optional — error/performance monitoring. Unset means Sentry is inactive.
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@o<org-id>.ingest.us.sentry.io/<project-id>
# Optional — enables readable (un-minified) stack traces by uploading source
# maps at build time. Requires an org-level Sentry auth token with the
# project:releases scope. Skipping this is safe; the build just logs that it
# skipped the upload.
# SENTRY_ORG=your-sentry-org-slug
# SENTRY_AUTH_TOKEN=sntrys_...
